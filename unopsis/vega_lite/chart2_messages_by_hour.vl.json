{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Messages received per hour",
  "description": "Line chart: messages ingested in each hour, with empty hours shown as zero.",
  "data": {
    "url": "/api/insights/messages-by-hour/"
  },
  "mark": {
    "type": "line",
    "point": true,
    "color": "#1d4e89"
  },
  "encoding": {
    "x": {
      "field": "hour",
      "timeUnit": "utcyearmonthdatehours",
      "type": "temporal",
      "title": "Hour (UTC)",
      "axis": {
        "format": "%b %d %H:00"
      }
    },
    "y": {
      "field": "total",
      "type": "quantitative",
      "title": "Messages",
      "axis": {
        "tickMinStep": 1
      }
    },
    "tooltip": [
      {
        "field": "hour",
        "timeUnit": "utcyearmonthdatehours",
        "type": "temporal",
        "title": "Hour (UTC)",
        "format": "%b %d, %H:00"
      },
      {
        "field": "total",
        "type": "quantitative",
        "title": "Messages"
      }
    ]
  },
  "width": 480,
  "height": 260,
  "config": {
    "background": "#fcfbf7",
    "font": "Plus Jakarta Sans, Segoe UI, sans-serif",
    "title": {
      "font": "Newsreader, Georgia, serif",
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#151413",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelColor": "#5c564e",
      "titleColor": "#5c564e",
      "labelFont": "JetBrains Mono, monospace",
      "labelFontSize": 10,
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "titleFontWeight": 600,
      "domainColor": "#bfb5a4",
      "tickColor": "#bfb5a4",
      "gridColor": "#e7e0d2"
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#b83a2a",
        "#2e5e7e",
        "#4e6e3a",
        "#1d4e89",
        "#8a5a12",
        "#5c564e"
      ]
    }
  }
}
