# Copy this file to `.env` (same folder as manage.py) and fill in real values.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# `.env` is git-ignored. This example file is safe to commit: it contains NO real secrets.
# Format rules: one KEY=value per line, no spaces around `=`, no quotes.

# Django's master secret. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-long-random-value

# Example third-party API key. A dummy value is fine while nothing calls the API yet.
OPENAI_API_KEY=dummy-key-not-real

# Hosts allowed to serve the site in PRODUCTION (comma-separated, no spaces).
# Development always allows localhost / 127.0.0.1.
#
# When the site is deployed, the deployed domain MUST be added here or Django answers every
# request with "DisallowedHost" -- it is refusing to serve a name it was not told about. On
# PythonAnywhere that name is <your-username>.pythonanywhere.com, so the line becomes:
#
#     ALLOWED_HOSTS=localhost,127.0.0.1,yourname.pythonanywhere.com
#
# Edit it in the real `.env` on the server. This example file is committed, so it stays local-only.
ALLOWED_HOSTS=localhost,127.0.0.1
