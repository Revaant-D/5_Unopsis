# Copy this file to `.env` (same folder as manage.py) and fill in real values.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# `.env` is git-ignored. This example file is safe to commit: it contains NO real secrets.
# Format rules: one KEY=value per line, no spaces around `=`, no quotes.

# Django's master secret. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-long-random-value

# Example third-party API key. A dummy value is fine while nothing calls the API yet.
OPENAI_API_KEY=dummy-key-not-real

# Hosts allowed to serve the site in PRODUCTION (comma-separated, no spaces).
# Development always allows localhost / 127.0.0.1.
#
# When the site is deployed, the deployed domain MUST be added here or Django answers every
# request with "DisallowedHost" -- it is refusing to serve a name it was not told about. On
# PythonAnywhere that name is <your-username>.pythonanywhere.com, so the line becomes:
#
#     ALLOWED_HOSTS=localhost,127.0.0.1,yourname.pythonanywhere.com
#
# Edit it in the real `.env` on the server. This example file is committed, so it stays local-only.
#
# Assignment 5 note: this one line now configures two things. Production settings derive
# CSRF_TRUSTED_ORIGINS from it (["https://" + host for each host here]), because log in, sign
# up and log out are the first POSTs the deployed site accepts and Django checks the Origin
# header on an HTTPS POST. Add the deployed domain here and both settings follow; there is no
# second place to edit, and no domain is written into any tracked file.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------------------
# Google sign-in (Assignment 5, Part 2)
# ---------------------------------------------------------------------------------------
# PLACEHOLDERS ONLY. This file is committed; the real pair belongs in `.env`, which is not.
# Treat the secret the way you would a password: it is the half of the credential that proves
# a request for somebody's Google identity really came from this site.
#
# Where they come from: Google Cloud Console -> APIs & Services -> Credentials ->
# "OAuth client ID" of type "Web application". The exact click-path, and the two redirect URIs
# that must be registered there, are in docs/a5/google-oauth-setup.md.
#
# Both lines may be left empty or deleted. settings/base.py only hands the credentials to
# django-allauth when BOTH are set, so a clone without them still starts, still passes
# `manage.py check` and still runs the whole test suite -- the login and sign-up pages simply
# show the "Continue with Google" button greyed out with a note saying why. Username and
# password are unaffected.
#
# Format reminder from the top of this file: no quotes, no spaces around `=`. A client id
# pasted with surrounding quotes is a client id Google will not recognise, and the error
# ("invalid_client") does not mention quoting.
GOOGLE_OAUTH_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-here


# ---------------------------------------------------------------------------------------
# What a brand-new account is given (Assignment 5)
# ---------------------------------------------------------------------------------------
# Assignment 5 scoped every queryset in unopsis/views.py to the account making the request, so
# one signed-in person can no longer read another's briefs. The cost is that a BRAND-NEW
# account owns nothing and therefore sees nothing: it signs in, the navigation fills with
# links, and every one of them leads to an empty page. Nothing errors, so it reads as a broken
# deployment -- and the account most likely to meet it is the grader's, created the first time
# anybody clicks "Continue with Google" on the live site.
#
# True (the default) gives each new account its OWN copy of the demo rows the moment it is
# created. Nothing is shared between accounts; see unopsis/onboarding.py for the alternatives
# that were rejected and why. Set it to False the day this holds data somebody cares about.
SEED_NEW_ACCOUNTS=True

# ---------------------------------------------------------------------------------------
# HTTPS-only cookies (production settings only)
# ---------------------------------------------------------------------------------------
# Read only by inboxtriage/settings/production.py, where it drives SESSION_COOKIE_SECURE,
# CSRF_COOKIE_SECURE and SECURE_SSL_REDIRECT together. True is correct on the deployed site:
# the session cookie now carries a signed-in identity, and without the Secure flag it travels
# in cleartext on any plain-HTTP request, where anybody on the path can copy it and become
# that user without a password.
#
# The ONLY reason to set it False is trying production mode on a laptop
# (`runserver --settings=inboxtriage.settings.production`), where there is no TLS: the browser
# would decline to store a Secure cookie and logging in would fail silently. It is a boolean,
# not a hostname, so nothing here needs to know the deployed domain.
HTTPS_ONLY=True

# ---------------------------------------------------------------------------------------
# Assignment 6: AI features (README_AI.md)
# ---------------------------------------------------------------------------------------
# External API: a free Groq key from https://console.groq.com/keys (no card needed).
# Without it the brief writer falls back to the built-in template writer.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local Hugging Face model. Downloaded automatically on first use (~5 GB for the default).
AI_LOCAL_MODEL=ibm-granite/granite-3.3-2b-instruct
# Set to False on PythonAnywhere (no torch on the free plan); the rules answer instead.
AI_LOCAL_ENABLED=True
# CPU precision: bfloat16 (~5 GB RAM, default) or float32 (~10 GB RAM; only with RAM to spare).
AI_LOCAL_CPU_DTYPE=bfloat16
# Prompting route (A): 0 zero-shot, 1 one-shot, 4 few-shot, 8 many-shot. Zero-shot won Route A.
AI_TRIAGE_SHOTS=0
