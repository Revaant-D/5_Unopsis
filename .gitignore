# ================================
# Environments & Secrets
# (.env holds the real SECRET_KEY / API keys and must NEVER be committed)
# ================================
.env
.env.*
!.env.example
env.py
venv/
env/
.venv/

# ================================
# Python
# ================================
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ================================
# Django
# ================================
# NOTE: db.sqlite3 is deliberately NOT ignored, and that is not an oversight.
# Assignment 4 requires the SQLite database to be committed and pushed with the code, so the
# grader (and PythonAnywhere) gets the demo data by cloning the repo instead of having to run
# `migrate` + `seed_demo` first. Please do not "fix" this by adding db.sqlite3 back: the file is
# ~240 KB, it holds nothing secret, and the assignment is checked against the data in it.
# (The usual rule -- a database is data, not code, and belongs outside version control -- comes
# back in A5, when a real database replaces the file.)

# Generated by `collectstatic`: a copy of static/ plus hashed filenames. Build output, so it is
# rebuilt on the server and never committed.
staticfiles/
media/
*.log

# ================================
# macOS / Windows junk
# ================================
.DS_Store
Thumbs.db
desktop.ini

# ================================
# IDEs & editors
# ================================
.idea/
.vscode/
*.swp
*.swo

# ================================
# Tests & coverage output
# ================================
.pytest_cache/
.coverage
htmlcov/

# ================================
# Jupyter
# ================================
.ipynb_checkpoints/
